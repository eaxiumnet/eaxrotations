#!/bin/sh
# Git pre-commit hook: prevent Lua syntax, spell ID, badge-count,
# spec-scorecard, and rotation/leveling/WotLK regressions in EaxRotations.
#
# Runs in this order:
#   1. luac -p on all .lua files (syntax check)
#   2. Vanilla TBC spell ID audit (negative: blocks TBC IDs in vanilla files)
#   3. Sylvanas spell ID audit (positive: every ID exists in DBC)
#   4. Badge drift check (README.md + AGENTS.md test counts match runners)
#   5. Spec scorecard drift check (live battery lanes + docs/scorecard.md)
#   6. Rotation test suite (full run, quiet mode)
#   7. Leveling test suite (full run, quiet mode)
#   8. WotLK rotation + leveling test suites (full run, quiet mode)
#   9. WotLK spell ID audit (positive: every ID exists in the WotLK bridge)
#  10. Cache-hit safe_state audit (static: frame-cache returns must wrap)
#      + self-test
#  11. Dead-matcher audit (static: every `_matches` def must be referenced)
#      + self-test
#  12. Vanilla existence audit + spell-audit self-tests (sylvanas/vanilla/
#      wotlk --self-test modes — pinned-rank enforcement, CI parity)
#  13. Clean-checkout dependency probe + self-test (untracked test-read
#      targets; the env-gap class that failed only in CI)
#  14. Version-consistency audit (header.lua plugin version == CHANGELOG top
#      release) + self-test
#  15. NS-member audit (static: every `NS.<member>(` call must target an
#      assigned, engine-surface, or allowlisted member — the los_guard /
#      cleanup_caches crash class) + self-test
#  16. Era-pair coverage audit (static: strategy-name sets compared across
#      sylvanas/vanilla/wotlk sibling files; divergences must stay within
#      the reviewed tests/era_pair_seed.lua baseline — the WotLK rogue
#      Kick-interrupt gap class) + self-test
#  17. Era-pair seed freshness guard (the committed era_pair_seed.lua must
#      byte-match a fresh regeneration from generate_era_pair_seed.py — the
#      audit allowlists whatever the seed contains, so a stale seed silently
#      weakens the era-coverage gate) + self-test
#
# INSTALL:
#   cp tools/pre-commit .git/hooks/pre-commit
#
# BYPASS:
#   SKIP_LUAC=1 git commit ...
#   git commit --no-verify (git commit -n)

set -e

# Allow bypass with --no-verify (git commit -n) or SKIP_LUAC=1
if [ -n "$SKIP_LUAC" ]; then
    echo "[pre-commit] SKIP_LUAC is set — skipping all checks"
    exit 0
fi

echo "[pre-commit] Running EaxRotations validation gate..."

# Pin the project's Lua 5.1 toolchain when present.
_LUA51="/c/Program Files (x86)/Lua/5.1"
if [ -x "$_LUA51/luac.exe" ]; then LUAC="$_LUA51/luac.exe"; else LUAC=luac; fi
if [ -x "$_LUA51/lua.exe" ]; then LUA="$_LUA51/lua.exe"; else LUA=lua; fi

# ---------------------------------------------------------------------------
# 1. luac -p syntax check
# ---------------------------------------------------------------------------
echo "[pre-commit] [1/17] Parsing all .lua files with luac -p..."

FAILED=0
TOTAL=0

TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT
find EaxRotations -name '*.lua' > "$TMPFILE"

while IFS= read -r file; do
    TOTAL=$((TOTAL + 1))
    if ! "$LUAC" -p "$file" 2>/dev/null; then
        echo "  SYNTAX ERROR: $file"
        FAILED=$((FAILED + 1))
    fi
done < "$TMPFILE"

echo "[pre-commit] Checked $TOTAL files."

if [ "$FAILED" -gt 0 ]; then
    echo "[pre-commit] $FAILED file(s) failed luac -p. Commit aborted."
    echo "[pre-commit] Fix syntax errors or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] All Lua files pass syntax check."

# ---------------------------------------------------------------------------
# 2. Vanilla TBC spell ID audit (negative: blocks TBC IDs in vanilla files)
# ---------------------------------------------------------------------------
echo "[pre-commit] [2/17] Running vanilla TBC spell ID audit..."

if ! "$LUA" EaxRotations/tests/run_vanilla_audit_tests.lua 2>&1; then
    echo "[pre-commit] Vanilla TBC spell ID audit FAILED. Commit aborted."
    echo "[pre-commit] Remove TBC-only spell IDs from vanilla spec files or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Vanilla TBC spell ID audit passed."

# ---------------------------------------------------------------------------
# 3. Sylvanas spell ID audit (positive: ensures every ID exists in DBC)
# ---------------------------------------------------------------------------
echo "[pre-commit] [3/17] Running sylvanas spell ID audit..."

if ! "$LUA" EaxRotations/tests/run_sylvanas_audit_tests.lua 2>&1; then
    echo "[pre-commit] Sylvanas spell ID audit FAILED. Commit aborted."
    echo "[pre-commit] Remove or fix invalid spell IDs (not in WoW 2.5.5.68101 DBC)."
    echo "[pre-commit] Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Sylvanas spell ID audit passed."

# ---------------------------------------------------------------------------
# 4. Badge drift check (README.md + AGENTS.md test counts match runners)
# ---------------------------------------------------------------------------
echo "[pre-commit] [4/17] Checking badge counts are in sync..."

if ! "$LUA" tools/update_badges.lua --check 2>&1; then
    echo "[pre-commit] Badge count drift detected. Commit aborted."
    echo "[pre-commit] Fix: run 'lua tools/update_badges.lua' and stage the diff, then commit again."
    echo "[pre-commit] Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Badge counts are in sync."

# ---------------------------------------------------------------------------
# 5. Spec scorecard drift check (live battery lanes + docs/scorecard.md)
#    Phase 0 gate: unclassified lanes, stale pins, or a stale doc abort.
# ---------------------------------------------------------------------------
echo "[pre-commit] [5/17] Checking spec scorecard is in sync..."

if ! "$LUA" tools/spec_scorecard.lua --check 2>&1; then
    echo "[pre-commit] Spec scorecard drift detected. Commit aborted."
    echo "[pre-commit] Fix: run 'lua tools/spec_scorecard.lua' and stage the diff, then commit again."
    echo "[pre-commit] Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Spec scorecard is in sync."

# ---------------------------------------------------------------------------#   6. Rotation test suite (the scorecard step above runs the battery, but the
#    full run_rotation_tests.lua matrix is the only gate that catches rotation
#    regressions before push; quiet mode suppresses per-suite chatter).
# ---------------------------------------------------------------------------
echo "[pre-commit] [6/17] Running rotation test suite..."

if ! "$LUA" EaxRotations/tests/run_rotation_tests.lua --quiet 2>&1; then
    echo "[pre-commit] Rotation test suite FAILED. Commit aborted."
    echo "[pre-commit] Fix the failing suite(s) above or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Rotation test suite passed."

# ---------------------------------------------------------------------------
# 7. Leveling test suite (31 suites; quiet mode). The scorecard battery covers
#    the rotation specs, but the leveling runners are a separate suite family
#    that CI's verify_all runs — a leveling regression must not pass the local
#    gate and fail only after push.
# ---------------------------------------------------------------------------
echo "[pre-commit] [7/17] Running leveling test suite..."

if ! "$LUA" EaxRotations/tests/run_leveling_tests.lua --quiet 2>&1; then
    echo "[pre-commit] Leveling test suite FAILED. Commit aborted."
    echo "[pre-commit] Fix the failing suite(s) above or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] Leveling test suite passed."

# ---------------------------------------------------------------------------
# 8. WotLK rotation + leveling test suites (45 suites; quiet mode).
# ---------------------------------------------------------------------------
echo "[pre-commit] [8/17] Running WotLK test suite..."

if ! "$LUA" EaxRotations/tests/run_wotlk_tests.lua --quiet 2>&1; then
    echo "[pre-commit] WotLK test suite FAILED. Commit aborted."
    echo "[pre-commit] Fix the failing suite(s) above or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] WotLK test suite passed."

# ---------------------------------------------------------------------------
# 9. WotLK spell ID audit (positive: every ID exists in the WotLK bridge).
# ---------------------------------------------------------------------------
echo "[pre-commit] [9/17] Running WotLK spell ID audit..."

if ! "$LUA" EaxRotations/tests/run_wotlk_audit_tests.lua 2>&1; then
    echo "[pre-commit] WotLK spell ID audit FAILED. Commit aborted."
    echo "[pre-commit] Fix the invalid WotLK spell IDs above or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

echo "[pre-commit] WotLK spell ID audit passed."

# ---------------------------------------------------------------------------
# 10. Cache-hit safe_state audit (static): every frame-cache build_state must
#     wrap its cache-hit return in spec_kit.safe_state(...) or the nil-guard
#     defaults leak as nil on frame-cache hits (the bear/cat bypass family,
#     6abb9039). The audit found and fixed a real instance in
#     warlock/leveling_sylvanas.lua on its first run. --self-test proves the
#     detector fires on synthetic raw returns.
# ---------------------------------------------------------------------------
echo "[pre-commit] [10/17] Running cache-hit safe_state audit..."

if ! "$LUA" EaxRotations/tests/run_cache_hit_audit_tests.lua 2>&1; then
    echo "[pre-commit] Cache-hit safe_state audit FAILED. Commit aborted."
    echo "[pre-commit] Wrap the flagged cache-hit branch in spec_kit.safe_state(...) or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_cache_hit_audit_tests.lua --self-test 2>&1; then
    echo "[pre-commit] Cache-hit audit self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Cache-hit safe_state audit passed."

# ---------------------------------------------------------------------------
# 11. Dead-matcher audit (static): every `_matches` function defined in a
#     class file must be referenced by at least one strategy. The resolver
#     handles all def/reference styles (local function / local = / module-
#     level defs; direct matches= / wrapper closures / custom_matches /
#     aliases) and ignores comment text. Its first run found and this gate
#     now protects against 38 orphaned matchers left by the WotLK DSL
#     substitution (strategies compiled from DSL_DEFS, old matcher funcs
#     unreachable). --self-test proves every style resolves correctly.
# ---------------------------------------------------------------------------
echo "[pre-commit] [11/17] Running dead-matcher audit..."

if ! "$LUA" EaxRotations/tests/run_dead_matcher_audit_tests.lua 2>&1; then
    echo "[pre-commit] Dead-matcher audit FAILED. Commit aborted."
    echo "[pre-commit] Remove the flagged dead matcher(s) or wire them into a strategy."
    echo "[pre-commit] Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_dead_matcher_audit_tests.lua --self-test 2>&1; then
    echo "[pre-commit] Dead-matcher audit self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Dead-matcher audit passed."

# ---------------------------------------------------------------------------
# 12. Vanilla existence audit + spell-audit self-tests (CI parity). The
#     existence audit is the positive vanilla check (every ID in Vanilla
#     data) complementing step 2's negative TBC-contamination check; the
#     three --self-test modes prove the pinned-rank allowlists/blocklists
#     still fire (a dropped pin silently passes the full-run audits). All
#     four are sub-second.
# ---------------------------------------------------------------------------
echo "[pre-commit] [12/17] Running vanilla existence audit..."

if ! "$LUA" EaxRotations/tests/run_vanilla_existence_audit.lua 2>&1; then
    echo "[pre-commit] Vanilla existence audit FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Vanilla existence audit passed."

for AUDIT in run_sylvanas_audit_tests run_vanilla_audit_tests run_wotlk_audit_tests; do
    echo "[pre-commit] Running $AUDIT --self-test..."
    if ! "$LUA" "EaxRotations/tests/$AUDIT.lua" --self-test 2>&1; then
        echo "[pre-commit] $AUDIT self-test FAILED (pinned ranks/pins no longer fire). Commit aborted."
        exit 1
    fi
done

echo "[pre-commit] Spell-audit self-tests passed."

# ---------------------------------------------------------------------------
# 12. Clean-checkout dependency probe + self-test. Every io.open/read_file
#     literal in tests/ must resolve to a git-tracked file or a
#     self-provisioning artifact (.omo/evidence regenerated per run) — a
#     test reading a gitignored file passes on a dev box and silently fails
#     on a clean checkout (the 5-suite env-gap class). The self-test pins
#     the POSIX directory-vs-file guard.
# ---------------------------------------------------------------------------
echo "[pre-commit] [13/17] Running clean-checkout dependency probe..."

if ! "$LUA" EaxRotations/tests/run_clean_checkout_probe.lua 2>&1; then
    echo "[pre-commit] Clean-checkout dependency probe FAILED. Commit aborted."
    echo "[pre-commit] A test reads an untracked/non-self-provisioning file. Fix or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_clean_checkout_probe.lua --self-test 2>&1; then
    echo "[pre-commit] Clean-checkout probe self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Clean-checkout dependency probe passed."

# ---------------------------------------------------------------------------
# 14. Version-consistency audit (static): header.lua plugin["version"] must
#     equal the top release in CHANGELOG.md. The runtime logs this version on
#     every reload (main.lua:1400) and the release convention used to bump the
#     README badge + PvP footer but never header.lua — the audit closes that
#     gap so a release can no longer ship a stale runtime version.
# ---------------------------------------------------------------------------
echo "[pre-commit] [14/17] Running version-consistency audit..."

if ! "$LUA" EaxRotations/tests/run_version_consistency_audit_tests.lua 2>&1; then
    echo "[pre-commit] Version-consistency audit FAILED. Commit aborted."
    echo "[pre-commit] Bump header.lua plugin version to the CHANGELOG top release or bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_version_consistency_audit_tests.lua --self-test 2>&1; then
    echo "[pre-commit] Version-consistency audit self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Version-consistency audit passed."

# ---------------------------------------------------------------------------
# 15. NS-member audit (static): every `NS.<member>(` call in classes/shared
#     must target a member that is repo-assigned, on the engine surface, or
#     on the documented ALLOWLIST (engine-provided optional members). The
#     allowlist is verified LIVE: a guarded= entry with an unguarded call
#     site (the los_guard crash shape) or a mock= entry the battery no
#     longer defines fails. Guards the two live-game crashes fixed this
#     session (incoming_heal_predictor cleanup_caches; los_guard same_unit).
# ---------------------------------------------------------------------------
echo "[pre-commit] [15/17] Running NS-member audit..."

if ! "$LUA" EaxRotations/tests/run_ns_member_audit_tests.lua 2>&1; then
    echo "[pre-commit] NS-member audit FAILED. Commit aborted."
    echo "[pre-commit] Define/guard the flagged NS member, or add it to ALLOWLIST"
    echo "[pre-commit] with the engine-provided evidence. Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_ns_member_audit_tests.lua --self-test 2>&1; then
    echo "[pre-commit] NS-member audit self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] NS-member audit passed."

# ---------------------------------------------------------------------------
# 16. Era-pair coverage audit (static): strategy-name sets compared across
#     sylvanas/vanilla/wotlk sibling files; any divergence outside the
#     reviewed tests/era_pair_seed.lua baseline fails — a strategy added to
#     one era without its siblings, or removed from one sibling (the WotLK
#     rogue Kick-interrupt gap, 2b3cc0d4, found only by hand). The seed is
#     regenerated deliberately via EaxRotations/tools/generate_era_pair_seed.py
#     and committed with the rotation change that re-baselines it.
# ---------------------------------------------------------------------------
echo "[pre-commit] [16/17] Running era-pair coverage audit..."

if ! "$LUA" EaxRotations/tests/run_era_pair_audit_tests.lua 2>&1; then
    echo "[pre-commit] Era-pair coverage audit FAILED. Commit aborted."
    echo "[pre-commit] A strategy exists in one era but is missing in a sibling era, outside"
    echo "[pre-commit] the reviewed baseline. Fix the sibling file(s) or regenerate the seed"
    echo "[pre-commit] deliberately (python EaxRotations/tools/generate_era_pair_seed.py)."
    echo "[pre-commit] Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_era_pair_audit_tests.lua --self-test 2>&1; then
    echo "[pre-commit] Era-pair audit self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Era-pair coverage audit passed."

# ---------------------------------------------------------------------------
# 17. Era-pair seed freshness guard (scorecard --check discipline applied to
#     the era-pair baseline). The audit allowlists whatever tests/era_pair_seed.lua
#     contains, so a stale seed (regeneration committed separately, or a
#     hand-edit) silently weakens the era-coverage gate. The committed seed
#     must byte-match a fresh in-memory regeneration from
#     EaxRotations/tools/generate_era_pair_seed.py --check (no writes).
# ---------------------------------------------------------------------------
echo "[pre-commit] [17/17] Checking era-pair seed freshness..."

if ! "$LUA" EaxRotations/tests/run_era_pair_seed_freshness.lua 2>&1; then
    echo "[pre-commit] Era-pair seed DRIFT detected. Commit aborted."
    echo "[pre-commit] Regenerate and commit the seed together with the rotation change:"
    echo "[pre-commit]   python EaxRotations/tools/generate_era_pair_seed.py"
    echo "[pre-commit] Bypass with: SKIP_LUAC=1 git commit ..."
    exit 1
fi

if ! "$LUA" EaxRotations/tests/run_era_pair_seed_freshness.lua --self-test 2>&1; then
    echo "[pre-commit] Era-pair seed freshness self-test FAILED. Commit aborted."
    exit 1
fi

echo "[pre-commit] Era-pair seed freshness check passed."
echo "[pre-commit] All 17 checks passed."
exit 0

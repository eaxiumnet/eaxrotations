-- menu.lua  |  Eax Druid Feral (Flux Port)  |  TBC  |  AstroUI
local AstroUI = require("ext_lib_astro_ui")
local settings = require("libraries/settings_framework")
local menu = {}

-- AstroUI Window
menu.ui = AstroUI.new({
    id = "eax_druid_feral",
    title = "EAX Druid Feral",
    theme = "druid",
    default_x = 700, default_y = 200,
    default_w = 450, default_h = 600,
    search = true,
    menu = menu
})

-- Controls
menu.enabled = core.menu.checkbox(true, "eaxdruidferalflux_enabled")
menu.toggle_key = core.menu.keybind(7, false, "eaxdruidferalflux_toggle_key")
menu.mode = core.menu.combobox(1, "eaxdruidferalflux_mode")
menu.debug = core.menu.checkbox(false, "eaxdruidferalflux_debug")

-- Targeting
menu.focus_priority = core.menu.checkbox(false, "eaxdruidferalflux_focus_priority")
menu.combat_self_hp_boost = core.menu.slider_int(0, 30, 10, "eaxdruidferalflux_combat_self_hp_boost")

-- Racial
menu.use_racial = core.menu.checkbox(true, "eaxdruidferalflux_use_racial")
menu.racial_hp = core.menu.slider_int(10, 80, 40, "eaxdruidferalflux_racial_hp")

-- Rotation - Cat
menu.use_rip = core.menu.checkbox(true, "eaxdruidferalflux_use_rip")
menu.use_rake = core.menu.checkbox(true, "eaxdruidferalflux_use_rake")
menu.use_shred = core.menu.checkbox(true, "eaxdruidferalflux_use_shred")
menu.use_mangle = core.menu.checkbox(true, "eaxdruidferalflux_use_mangle")
menu.use_ferocious_bite = core.menu.checkbox(true, "eaxdruidferalflux_use_fb")
menu.use_tigers_fury = core.menu.checkbox(true, "eaxdruidferalflux_use_tf")
menu.use_prowl_opener = core.menu.checkbox(true, "eaxdruidferalflux_use_prowl")

-- Powershift
menu.auto_powershift = core.menu.checkbox(true, "eaxdruidferalflux_auto_ps")
menu.powershift_min_mana = core.menu.slider_int(10, 50, 25, "eaxdruidferalflux_ps_mana")

-- Cooldowns
menu.use_berserk = core.menu.checkbox(true, "eaxdruidferalflux_use_berserk")

-- Defensive
menu.use_barkskin = core.menu.checkbox(true, "eaxdruidferalflux_use_barkskin")
menu.barkskin_hp = core.menu.slider_int(10, 50, 30, "eaxdruidferalflux_barkskin_hp")

settings.setup_major_toggle_keybinds(menu, {
    { toggle = "use_rip", label = "Rip" },
    { toggle = "use_rake", label = "Rake" },
    { toggle = "use_shred", label = "Shred" },
}, {
    namespace = "eaxdruidferalflux",
    log_prefix = "[Eax Druid Feral Flux] ",
})

-- Build UI Tabs
menu.ui:add_tab({ id = "general", label = "General" }, function(t)
    t:checkbox_grid({
        label = "Controls",
        columns = 2,
        elements = {
            { element = menu.enabled, label = "Enabled" },
            { element = menu.debug, label = "Debug Logging" },
        }
    })
    t:keybind_grid({
        labels = { "Toggle Key" },
        elements = { menu.toggle_key }
    })
    t:combo_list({
        label = "Mode",
        elements = {
            { element = menu.mode, label = "Mode", options = { "Auto", "Solo", "Dungeon", "Raid" }, dropdown = true }
        }
    })
end)

menu.ui:add_tab({ id = "rotation", label = "Rotation" }, function(t)
    t:checkbox_grid({
        label = "Finishers",
        columns = 2,
        elements = {
            { element = menu.use_rip, label = "Rip" },
            { element = menu.use_ferocious_bite, label = "Ferocious Bite" },
        }
    })
    t:checkbox_grid({
        label = "DoTs",
        columns = 2,
        elements = {
            { element = menu.use_rake, label = "Rake" },
            { element = menu.use_mangle, label = "Mangle" },
        }
    })
    t:checkbox_grid({
        label = "Builders",
        columns = 2,
        elements = {
            { element = menu.use_shred, label = "Shred" },
        }
    })
    t:checkbox_grid({
        label = "Cooldowns",
        columns = 2,
        elements = {
            { element = menu.use_tigers_fury, label = "Tiger's Fury" },
            { element = menu.use_prowl_opener, label = "Prowl Opener" },
            { element = menu.use_berserk, label = "Berserk" },
        }
    })
end)

menu.ui:add_tab({ id = "powershift", label = "Powershift" }, function(t)
    t:checkbox_grid({
        label = "Energy Management",
        columns = 2,
        elements = {
            { element = menu.auto_powershift, label = "Auto Powershift" },
        }
    })
    t:slider_list({
        label = "Energy Management",
        elements = {
            { element = menu.powershift_min_mana, label = "Min Mana %" },
        }
    })
end)

menu.ui:add_tab({ id = "defensive", label = "Defensive" }, function(t)
    t:checkbox_grid({
        label = "Self Defense",
        columns = 2,
        elements = {
            { element = menu.use_barkskin, label = "Barkskin" },
        }
    })
    t:slider_list({
        label = "Self Defense",
        elements = {
            { element = menu.barkskin_hp, label = "Barkskin HP %" },
        }
    })
end)

menu.ui:add_tab({ id = "targeting", label = "Targeting" }, function(t)
    t:checkbox_grid({
        label = "Priority",
        columns = 2,
        elements = {
            { element = menu.focus_priority, label = "Focus Target Priority" },
        }
    })
    t:slider_list({
        label = "Priority",
        elements = {
            { element = menu.combat_self_hp_boost, label = "Self-Heal Bonus %" },
        }
    })
end)

menu.ui:add_tab({ id = "racial", label = "Racial" }, function(t)
    t:checkbox_grid({
        label = "Racial Ability",
        columns = 2,
        elements = {
            { element = menu.use_racial, label = "Use Racial" },
        }
    })
    t:slider_list({
        label = "Racial Ability",
        elements = {
            { element = menu.racial_hp, label = "Racial HP %" },
        }
    })
end)

-- Register with AstroUI
AstroUI.register_window(menu.ui)

-- Render callbacks
function menu.on_render() menu.ui:on_render() end
function menu.on_menu_render() menu.ui:on_menu_render() end

return menu
